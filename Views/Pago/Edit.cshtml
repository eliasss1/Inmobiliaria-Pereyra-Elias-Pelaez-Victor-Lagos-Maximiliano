@model Inmobiliaria.Models.Pago

@{
    ViewData["Title"] = "Editar Pago";
}

@if(TempData["TeLaMandaste"] != null)
{
    <div class="container-fluid bg-danger rounded-2 d-flex justify-content-center align-items-center">
        <h3>@TempData["TeLaMandaste"]</h3>
    </div>
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h3 class="mb-0">Editar datos del Pago @Model.IdPago</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="IdPago" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Concepto" class="form-label fw-bold"></label>
                        <input asp-for="Concepto" class="form-control" />
                        <span asp-validation-for="Concepto" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    @if (User.IsInRole("Administrador"))
                        {
                            <div class="col-md-4 mb-3">
                                <label asp-for="Estado" class="form-label fw-bold"></label>
                                <select asp-for="Estado" class="form-select">
                                    <option value="Activo">Activo</option>
                                    <option value="Anulado">Anulado</option>
                                </select>
                                <span asp-validation-for="Estado" class="text-danger"></span>
                            </div>
                        }
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                    <button type="submit" class="btn btn-warning fw-bold">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 