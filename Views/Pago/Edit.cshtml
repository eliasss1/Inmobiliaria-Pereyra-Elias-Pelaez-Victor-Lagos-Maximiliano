@model Inmobiliaria.Models.Pago

@{
    ViewData["Title"] = "Editar Pago";
}

@if(TempData["TeLaMandaste"] != null)
{
    <div class="container-fluid bg-danger rounded-2 d-flex justify-content-center align-items-center">
        <h3>@TempData["TeLaMandaste"]</h3>
    </div>
}

<div class="container d-flex justify-content-center align-items-center">
    <form asp-controller="Pago" asp-action="Edit" class="form-gor2 d-flex flex-column justify-content-start m-2 p-5 gap-2 shadow" method="post">
        <h3 class="mb-0">Editar datos del Pago @Model.IdPago</h3>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="IdPago" />

        
        <div class="form-group w-50">
            <label asp-for="Concepto" class="form-label fw-bold"></label>
            <input asp-for="Concepto" class="form-control" />
            <span asp-validation-for="Concepto" class="text-danger"></span>
        </div>

        @if (User.IsInRole("Administrador"))
            {
                <div class="form-group w-50">
                    <label asp-for="Estado" class="form-label fw-bold"></label>
                    <select asp-for="Estado" class="form-select">
                        <option value="Activo">Activo</option>
                        <option value="Anulado">Anulado</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>
            }


        <div class="d-flex justify-content-end mt-4">
            <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
            <button type="submit" class="btn btn-primary fw-bold">Guardar Cambios</button>
        </div>
    </form>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 