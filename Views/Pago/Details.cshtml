@model Inmobiliaria.Models.Pago
@inject Inmobiliaria.Models.IRepositorioUsuario RepoUsuario
<h2>Detalles del Pago</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.IdPago</dd>

        <dt class="col-sm-3">Concepto</dt>
        <dd class="col-sm-9">@Model.Concepto</dd>

        <dt class="col-sm-3">FechaPago</dt>
        <dd class="col-sm-9">@Model.FechaPago.ToShortDateString()</dd>

        <dt class="col-sm-3">Importe</dt>
        <dd class="col-sm-9">@Model.Importe</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">@Model.Estado</dd>

        <dt class="col-sm-3">ID de Reserva</dt>
        <dd class="col-sm-9">@Model.IdReserva</dd>
        
        @if (User.IsInRole("Administrador"))
        {
            <dt class="col-sm-3">Creado Por</dt>
            <dd class="col-sm-9">@(RepoUsuario.ObtenerPorId(Model.IdUsuarioCreador)?.Nombre) @(RepoUsuario.ObtenerPorId(Model.IdUsuarioCreador)?.Apellido)</dd>
            
            @if(Model.IdUsuarioAnulador.HasValue)
            {
                <dt class="col-sm-3">Anulado Por</dt>
                <dd class="col-sm-9">@(RepoUsuario.ObtenerPorId(Model.IdUsuarioAnulador.Value)?.Nombre) @(RepoUsuario.ObtenerPorId(Model.IdUsuarioAnulador.Value)?.Apellido)</dd>
            }
        }
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.IdPago" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
