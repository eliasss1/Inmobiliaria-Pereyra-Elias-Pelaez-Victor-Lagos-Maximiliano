@model Inmobiliaria.Models.Inmueble
<div class="container d-flex justify-content-center align-items-center">
    <form asp-controller="Inmueble" asp-action="Create" class="form-gor2 d-flex flex-column justify-content-start m-2 p-5 gap-2 shadow"  method="post">
        
        <input type="hidden" asp-for="IdPropietario" />
        <h1 style="font-family: 'Inter', sans-serif; font-weight: 500; letter-spacing: -0.02em;">Crear un nuevo Inmueble</h1>
        <div class="w-50">
            <label>Direccion</label>
            <input asp-for="Direccion" class="form-control"/>
        </div>
        <div class="w-50">
            <label>Cupo</label>
            <input asp-for="Cupo" class="form-control"/>
        </div>
        <div class="w-50">
            <label>Latitud</label>
            <input asp-for="Latitud" class="form-control"/>
        </div>
        <div class="w-50">
            <label>Longitud</label>
            <input asp-for="Longitud" class="form-control"/>
        </div>
        <div class="w-50">
            <label>Precio por Dia</label>
            <input asp-for="PrecioPorDia" class="form-control"/>
        </div>
        <div class="w-50">
            <label>Porcentaje de seña</label>
            <input asp-for="PorcentajeSeña" class="form-control" type="number" min="0" max="100" step="0.01" />
        </div>
        
        
        <div class="w-50">
            <label>Tipo de Inmueble</label>
            
            <select asp-for="IdTipoInmueble" class="form-control" asp-items="ViewBag.Tipos">
                <option value="">-- Seleccione un Tipo --</option>
            </select>
        </div>

        <div class="d-flex justify-content-end mt-3 gap-2">
            <a asp-controller="Inmueble" asp-action="Index" class="btn btn-secondary">Volver</a>
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    </form>
</div>