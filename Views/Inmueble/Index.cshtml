
@model IEnumerable<Inmobiliaria.Models.Inmueble>

<div class="p-2 bg-light">
    <div class="d-flex justify-content-between mt-2"> 
        <h1>Listado de Inmuebles</h1>
        @if (ViewBag.IdPropietario != null)
        {
            <a asp-controller="Inmueble" asp-action="Create" asp-route-idPropietario="@ViewBag.IdPropietario" class="btn btn-success">
                Agregar Inmueble a este Propietario
            </a>
        }
    </div>


    <div class="m-5 table-responsive">
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Propietario</th>
                    <th>Tipo</th>
                    <th>Direccion</th>
                    <th>Estado</th>
                    <th>Cupo</th>
                    <th>Latitud</th>
                    <th>Longitud</th>
                    <th>PrecioPorDia</th>
                    <th>Opciones</th>
                </tr>
            </thead>
            
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdInmueble

                        </td>
                        <td>@item.Dueño

                        </td>
                        <td>@item.Tipo

                        </td>
                        <td>@item.Direccion

                        </td>

                        @if(@item.Estado == true){
                            <td>Disponible</td>
                        }else{
                            <td>Ocupado</td>
                        }
                        
                        <td>@item.Cupo

                        </td>
                        <td>@item.Latitud

                        </td>
                        <td>@item.Longitud
                            
                        </td>
                        <td>@item.PrecioPorDia

                        </td>
                        <td class="d-flex gap-1">
                            <a asp-controller="Inmueble" asp-action="Edit" asp-route-id="@item.IdInmueble" class="btn btn-primary btn-sm">Editar</a>

                            <form asp-controller="Inmueble" asp-action="Eliminar" asp-route-id="@item.IdInmueble" method="post" onsubmit="return confirm('¿Seguro que queres borrar este inmueble?');">
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i> Borrar
                                </button>
                            </form>
                        </td>
                        
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>