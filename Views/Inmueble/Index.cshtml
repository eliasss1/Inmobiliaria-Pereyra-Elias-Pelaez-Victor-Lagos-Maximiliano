@model IEnumerable<Inmobiliaria.Models.Inmueble>

@{
    ViewData["Title"] = "Listado de Inmuebles";
}

<div class="container mt-4">

    <form asp-controller="Inmueble" asp-action="Index" method="get" class="mb-3 d-flex flex-wrap gap-2">
        <input type="text" name="buscar" class="form-control" style="width: auto; flex-grow: 1;" placeholder="Buscar por Dirección o Tipo..." value="@ViewBag.Buscar" />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-controller="Inmueble" asp-action="Index" class="btn btn-outline-danger">Limpiar</a>
        
        <div class="dropdown">
            <button class="btn btn-info dropdown-toggle" type="button" id="informesInmuebles" data-bs-toggle="dropdown" aria-expanded="false">
                Informes
            </button>
            <ul class="dropdown-menu" aria-labelledby="informesInmuebles">
                <li><a class="dropdown-item" asp-action="PorDisponibilidad">Filtrar por Disponibilidad</a></li>
                <li><a class="dropdown-item" asp-action="MasReservados">Más reservados (últimos 365 días)</a></li>
                <li><a class="dropdown-item" asp-action="SinReservas">Sin reservas (últimos X días)</a></li>
                <li><a class="dropdown-item" asp-action="LibresEntreFechas">Libres entre fechas</a></li>
            </ul>
        </div>
    </form>
    
    @if (ViewBag.MostrarFormFechas == true)
    {
        <div class="card mb-3 p-3 bg-light">
            <form asp-action="LibresEntreFechas" method="get" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="col-form-label fw-bold">Fecha Inicio:</label>
                </div>
                <div class="col-auto">
                    <input type="date" name="inicio" class="form-control" required />
                </div>
                <div class="col-auto">
                    <label class="col-form-label fw-bold">Fecha Fin:</label>
                </div>
                <div class="col-auto">
                    <input type="date" name="fin" class="form-control" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-success">Ver Inmuebles Libres</button>
                </div>
            </form>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            @if (ViewBag.FiltroActivo != null)
            {
                <text>Inmuebles - @ViewBag.FiltroActivo</text>
            }
            else
            {
                <text>Listado de Inmuebles</text>
            }
        </h2>
        
        @if (ViewBag.IdPropietario != null)
        {
            <a asp-controller="Inmueble" asp-action="Create" asp-route-idPropietario="@ViewBag.IdPropietario" class="btn btn-primary shadow-sm">
                Crear Nuevo Inmueble
            </a>
        }
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover align-middle border">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Dirección</th>
                    <th>Tipo</th>
                    <th>Cupo</th>
                    <th>Precio/Día</th>
                    <th>Estado</th>
                    <th>Dueño</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No se encontraron inmuebles con esos criterios de busqueda.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var i in Model)
                    {
                        <tr>
                            <td>@i.IdInmueble</td>
                            <td>@i.Direccion</td>
                            <td>@i.Tipo?.Nombre</td> 
                            <td>@i.Cupo pers.</td>
                            <td>$@i.PrecioPorDia.ToString("N2")</td>
                            <td>
                                @if(i.Estado)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td>@i.Dueño?.Nombre @i.Dueño?.Apellido</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@i.IdInmueble" class="btn btn-warning btn-sm">Editar</a>
                                <form asp-action="Eliminar" asp-route-id="@i.IdInmueble" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que queres eliminar este inmueble?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination">
                    <li class="page-item @(ViewBag.Pagina == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.Pagina - 1)" asp-route-buscar="@ViewBag.Buscar">Anterior</a>
                    </li>
                    <li class="page-item active"><span class="page-link">Pagina @ViewBag.Pagina de @ViewBag.TotalPaginas</span></li>
                    <li class="page-item @(ViewBag.Pagina >= ViewBag.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.Pagina + 1)" asp-route-buscar="@ViewBag.Buscar">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>