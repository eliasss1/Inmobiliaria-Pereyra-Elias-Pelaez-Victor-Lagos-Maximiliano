@model IEnumerable<Inmobiliaria.Models.Inmueble>

@{
    ViewData["Title"] = "Listado de Inmuebles";
}

<div class="container mt-4">

    <form asp-controller="Inmueble" asp-action="Index" method="get" class="mb-3 d-flex">
        <input type="text" name="buscar" class="form-control me-2" placeholder="Buscar por Dirección o Tipo..." value="@ViewBag.Buscar" />
        <button type="submit" class="btn btn-outline-secondary me-2">Buscar</button>
        <a asp-controller="Inmueble" asp-action="Index" class="btn btn-outline-danger">Limpiar</a>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Listado de Inmuebles</h2>
        <a asp-controller="Inmueble" asp-action="Create" class="btn btn-primary shadow-sm">
            Crear Nuevo Inmueble
        </a>
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover align-middle border">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Dirección</th>
                    <th>Tipo</th>
                    <th>Cupo</th>
                    <th>Precio/Día</th>
                    <th>Estado</th>
                    <th>Dueño</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No se encontraron inmuebles con esos criterios de busqueda.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var i in Model)
                    {
                        <tr>
                            <td>@i.IdInmueble</td>
                            <td>@i.Direccion</td>
                            <td>@i.Tipo?.Nombre</td> 
                            <td>@i.Cupo pers.</td>
                            <td>$@i.PrecioPorDia.ToString("N2")</td>
                            <td>
                                @if(i.Estado)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td>@i.Dueño?.Nombre @i.Dueño?.Apellido</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@i.IdInmueble" class="btn btn-warning btn-sm">Editar</a>
                                <form asp-action="Eliminar" asp-route-id="@i.IdInmueble" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que queres eliminar este inmueble?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination">
                    <li class="page-item @(ViewBag.Pagina == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.Pagina - 1)" asp-route-buscar="@ViewBag.Buscar">Anterior</a>
                    </li>
                    <li class="page-item active"><span class="page-link">Pagina @ViewBag.Pagina de @ViewBag.TotalPaginas</span></li>
                    <li class="page-item @(ViewBag.Pagina >= ViewBag.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.Pagina + 1)" asp-route-buscar="@ViewBag.Buscar">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>