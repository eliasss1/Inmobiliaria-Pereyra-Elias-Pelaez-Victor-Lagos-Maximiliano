@model Inmobiliaria.Models.Inmueble

<div class="container">
    <h2 class="mt-4">Editar Inmueble</h2>
    
    <form asp-controller="Inmueble" asp-action="Edit" class="d-flex flex-column justify-content-center m-2 p-5 gap-3 border rounded" method="post" enctype="multipart/form-data">
        
        <input type="hidden" asp-for="IdInmueble" />
        <input type="hidden" asp-for="IdPropietario" />
        <input type="hidden" asp-for="ImagenPortada" />

        <div class="row">
            <div class="col-md-6">
                <label class="fw-bold">Direccion</label>
                <input asp-for="Direccion" class="form-control"/>
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>
            
            <div class="col-md-6">
                <label class="fw-bold">Tipo de Inmueble</label>
                <select asp-for="IdTipoInmueble" class="form-control" asp-items="ViewBag.Tipos"></select>
                <span asp-validation-for="IdTipoInmueble" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <label class="fw-bold">Cupo (Personas)</label>
                <input asp-for="Cupo" class="form-control" type="number" />
            </div>
            <div class="col-md-4">
                <label class="fw-bold">Precio por Dia ($)</label>
                <input asp-for="PrecioPorDia" class="form-control" type="number" step="0.01" />
            </div>
            <div class="col-md-4">
                <label class="fw-bold">Porcentaje de se&ntilde;a</label>
                <input asp-for="PorcentajeSeña" class="form-control" type="number" min="0" max="100" step="0.01" />
            </div>
            <div class="col-md-4 d-flex align-items-end mt-2">
                <div class="form-check mb-2">
                    <input asp-for="Estado" class="form-check-input" type="checkbox" />
                    <label class="form-check-label fw-bold">Activo (Disponible)</label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <label class="fw-bold">Latitud</label>
                <input asp-for="Latitud" class="form-control" type="number" step="any" />
            </div>
            <div class="col-md-6">
                <label class="fw-bold">Longitud</label>
                <input asp-for="Longitud" class="form-control" type="number" step="any" />
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <label class="fw-bold">Cambiar imagen de portada</label>
                <input type="file" name="portadaFile" class="form-control" accept="image/*" />
                @if (!string.IsNullOrEmpty(Model.ImagenPortada))
                {
                    <div class="mt-2">
                        <img src="@Model.ImagenPortada" style="width: 120px; height: 120px; object-fit: cover; border-radius: 8px; border: 1px solid #ccc;" />
                    </div>
                }
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <label class="fw-bold">Agregar nuevas im&aacute;genes</label>
                <input type="file" name="imagenesFiles" multiple class="form-control" accept="image/*" />
            </div>
        </div>

        @{ var imagenes = ViewBag.Imagenes as IList<Inmobiliaria.Models.InmuebleImagen>; }
        @if (imagenes != null && imagenes.Count > 0)
        {
            <div class="row mt-3">
                <div class="col-12">
                    <label class="fw-bold">Im&aacute;genes actuales</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach(var img in imagenes)
                        {
                            <div class="position-relative" id="img-@img.IdImagen">
                                <img src="@img.Url" style="width: 100px; height: 100px; object-fit: cover; border-radius: 5px; border: 1px solid #ccc;" />
                                <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1" onclick="eliminarImagen(@img.IdImagen)" title="Eliminar"><i class="bi bi-trash"></i></button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        </div>
    </form>
</div>

<script>
    function eliminarImagen(id) {
        if(confirm('¿Seguro que deseas eliminar esta imagen?')) {
            $.post('/Inmueble/EliminarImagen', { idImagen: id }, function() {
                $('#img-' + id).remove();
            }).fail(function() {
                alert('Error al eliminar la imagen.');
            });
        }
    }
</script>
