@model Inmobiliaria.Models.Inmueble

<h2>Detalles del Inmueble</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Id Inmueble</dt>
        <dd class="col-sm-9">@Model.IdInmueble</dd>

        <dt class="col-sm-3">Direccion</dt>
        <dd class="col-sm-9">@Model.Direccion</dd>

        <dt class="col-sm-3">Cupo</dt>
        <dd class="col-sm-9">@Model.Cupo</dd>

        <dt class="col-sm-3">Latitud</dt>
        <dd class="col-sm-9">@Model.Latitud</dd>

        <dt class="col-sm-3">Longitud</dt>
        <dd class="col-sm-9">@Model.Longitud</dd>

        <dt class="col-sm-3">Precio por Dia</dt>
        <dd class="col-sm-9">@Model.PrecioPorDia</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">@(Model.Estado ? "Disponible" : "No Disponible")</dd>

        <dt class="col-sm-3">Porcentaje de Seña</dt>
        <dd class="col-sm-9">@Model.PorcentajeSeña</dd>

                <dt class="col-sm-3">Im&aacute;genes</dt>
        <dd class="col-sm-9">
            @{ var imagenes = ViewBag.Imagenes as IList<Inmobiliaria.Models.InmuebleImagen>; }
            @if (!string.IsNullOrEmpty(Model.ImagenPortada) || (imagenes != null && imagenes.Count > 0))
            {
                var imagenesTotales = new List<string>();
                if (!string.IsNullOrEmpty(Model.ImagenPortada))
                {
                    imagenesTotales.Add(Model.ImagenPortada);
                }
                if (imagenes != null)
                {
                    foreach (var img in imagenes)
                    {
                        if (!string.IsNullOrEmpty(img.Url) && !imagenesTotales.Contains(img.Url))
                        {
                            imagenesTotales.Add(img.Url);
                        }
                    }
                }

                if (imagenesTotales.Count > 0)
                {
                    <div id="carouselInmueble" class="carousel slide" data-bs-ride="carousel" style="max-width: 500px;">
                        <div class="carousel-inner rounded shadow-sm">
                            @for (int i = 0; i < imagenesTotales.Count; i++)
                            {
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@imagenesTotales[i]" class="d-block w-100" style="height: 300px; object-fit: cover;" alt="Imagen inmueble">
                                </div>
                            }
                        </div>
                        @if (imagenesTotales.Count > 1) {
                            <button class="carousel-control-prev" type="button" data-bs-target="#carouselInmueble" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#carouselInmueble" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <span class="text-muted">No hay im&aacute;genes adicionales.</span>
            }
        </dd>

        <dt class="col-sm-3">Id Tipo Inmueble</dt>
        <dd class="col-sm-9">@Model.IdTipoInmueble</dd>

        <dt class="col-sm-3">Id Propietario</dt>
        <dd class="col-sm-9">@Model.IdPropietario</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.IdInmueble" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
