@{
    ViewData["Title"] = "Home Page";
}



<div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 80vh;">
    @if (@User.Identity.IsAuthenticated){
        <h1 class="display-4 mb-5" style="font-family: 'Inter', sans-serif; font-weight: 500; letter-spacing: -0.02em;">Bienvenido al Sistema @User.Identity.Name</h1>
        <div class="justify-content-between">
            <a id="btn-inicio" class="btn m-2 btn-animado" style="background-color: transparent; border: 2px solid #1520c0; box-shadow: 0px 5px 9px rgba(0, 0, 0, 0.2);" asp-controller="Inmueble" asp-action="Index">
                <div class="p-2 align-items-center"  style="width: 300px; height: 100px;">
                    <i class='bi bi-house-door fs-4 text-center'></i>
                    <p class="text-center">Gestiona los inmuebles de la inmobiliaria.</p>
                </div>
            </a>
            <a id="btn-inicio" class="btn m-2 btn-animado" style="background-color: transparent; border: 2px solid #1520c0; box-shadow: 0px 5px 9px rgba(0, 0, 0, 0.2);" asp-controller="Propietario" asp-action="Index">
                <div class="p-2 align-items-center"  style="width: 300px; height: 100px;">
                    <i class="bi bi-person-workspace fs-4 text-center""></i>
                    <p class="text-center">Gestiona los propietarios de la inmobiliaria.</p> 
                </div>
            </a>
            <a id="btn-inicio" class="btn m-2 btn-animado" style="background-color: transparent; border: 2px solid #1520c0; box-shadow: 0px 5px 9px rgba(0, 0, 0, 0.2);" asp-controller="Inquilino" asp-action="Index">
                <div class="p-2 align-items-center"  style="width: 300px; height: 100px;">
                    <i class="bi bi-key fs-4 text-center"></i>
                    <p class="text-center">Gestiona los inquilinos de la inmobiliaria.</p>
                </div>
            </a>
        </div>
        <div class="justify-content-between">
            <a id="btn-inicio" class="btn m-2 btn-animado" style="background-color: transparent; border: 2px solid #1520c0; box-shadow: 0px 5px 9px rgba(0, 0, 0, 0.2);" asp-controller="Reserva" asp-action="Index">
                <div class="p-2 align-items-center"  style="width: 300px; height: 100px;">
                    <i class='bi bi-calendar fs-4 text-center'></i>
                    <p class="text-center">Gestiona las reservas de la inmobiliaria.</p>
                </div>
            </a>
            <a id="btn-inicio" class="btn m-2 btn-animado" style="background-color: transparent; border: 2px solid #1520c0; box-shadow: 0px 5px 9px rgba(0, 0, 0, 0.2);" asp-controller="TipoInmueble" asp-action="Index">
                <div class="p-2 align-items-center"  style="width: 300px; height: 100px;">
                    <i class="bi bi-tag fs-4 text-center"></i>
                    <p class="text-center">Gestiona los TIPOS de inmuebles de la inmobiliaria.</p> 
                </div>
            </a>
            <a id="btn-inicio" class="btn m-2 btn-animado" style="background-color: transparent; border: 2px solid #1520c0; box-shadow: 0px 5px 9px rgba(0, 0, 0, 0.2);" asp-controller="Pago" asp-action="Index">
                <div class="p-2 align-items-center"  style="width: 300px; height: 100px;">
                    <i class="bi bi-currency-dollar fs-4 text-center"></i>
                    <p class="text-center">Gestiona los pagos de la inmobiliaria.</p>
                </div>
            </a>
        </div>
        <a id="btn-inicio" class="btn m-2 btn-animado" style="background-color: transparent; border: 2px solid #1520c0; box-shadow: 0px 5px 9px rgba(0, 0, 0, 0.2);" asp-controller="Usuario" asp-action="Perfil">
                <div class="p-2 align-items-center"  style="width: 300px; height: 100px;">
                    <i class="bi bi-person fs-4 text-center"></i>
                    <p class="text-center">Dale un vistazo a tu propio perfil</p>
                </div>
        </a>
        @if (User.IsInRole("Administrador"))
        {
            <div class="justify-content-between">
                <a id="btn-inicio" class="btn m-2 btn-animado" style="background-color: transparent; border: 2px solid #1520c0; box-shadow: 0px 5px 9px rgba(0, 0, 0, 0.2);" asp-controller="Usuario" asp-action="Index">
                    <div class="p-2 align-items-center"  style="width: 300px; height: 100px;">
                        <i class='bi bi-person fs-4 text-center'></i>
                        <p class="text-center">Gestiona los usuarios del sistema.</p>
                    </div>
                </a>
            </div>
        }    
    } 
    else
    {
        <h1 class="display-4 titulo-suave" style="font-family: 'Inter', sans-serif; font-weight: 500; letter-spacing: -0.02em;">Bienvenido al Sistema</h1>
        <p class="lead">Por favor, inicia sesión para acceder a las funcionalidades del sistema.</p>
        <a class="btn btn-primary" asp-controller="Usuario" asp-action="Login">Iniciar Sesión</a>
    }
</div>

<style>
    .btn-animado {
    transition: transform 0.2s ease-in-out !important;
    }


    .btn-animado:hover {
    transform: scale(1.05) !important;
    }
</style>