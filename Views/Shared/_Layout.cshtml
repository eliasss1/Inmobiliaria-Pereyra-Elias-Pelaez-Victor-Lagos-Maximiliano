<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inmobiliaria "GOR2"</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Inmobiliaria_Pereyra_Elias_Pelaez_Victor_Lagos_Maximiliano.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark box-shadow mb-3" style="background-color: #2b2f69;">
            <div class="container-fluid">
                <a class="navbar-brand" style="color: #ffffff; font-weight: bold;" asp-area="" asp-controller="Home" asp-action="Index">InmobiliariaEMV</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
                <div class="d-flex justify-content-end align-items-center">

                    <button id="theme-toggle-btn" class="btn btn-secondary me-2">
                        <i id="theme-icon" class="bi bi-brightness-high-fill"></i>
                    </button>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="navbar-text text-white me-3 ms-3">Bienvenido, @User.Identity.Name</span>
                            <form asp-controller="Usuario" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link text-white">Cerrar Sesión</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-end gap-1">
                            <a class="btn btn-light" asp-controller="Usuario" asp-action="login">Iniciar Sesion</a>
                        </div>
                    }

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted p-3" style="border-top: 1px solid #2b2f69;">
        <div class="container">
            &copy; 2026 - Inmobiliaria_Pereyra_Elias_Pelaez_Victor_Lagos_Maximiliano - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        const root = document.documentElement;
        const iconsito = document.getElementById('theme-icon');

        const TemaGuar = localStorage.getItem('theme') || 'light';
        root.setAttribute('data-bs-theme', TemaGuar);

        

        if(TemaGuar === 'dark'){
            iconsito.className = 'bi bi-brightness-low-fill';
        }else if (TemaGuar === 'light'){
            iconsito.className = 'bi bi-brightness-high-fill';
        }

        document.getElementById('theme-toggle-btn').addEventListener('click', function () {

            const temaActual = root.getAttribute('data-bs-theme');

            if(temaActual === 'dark'){

                const nuevoTema = 'light';
                root.setAttribute('data-bs-theme', nuevoTema);
                const nuevoIcono = 'bi bi-brightness-low-fill';
                iconsito.className = nuevoIcono;
                localStorage.setItem('theme', nuevoTema);

            }else if (temaActual === 'light'){

                const nuevoTema = 'dark';
                root.setAttribute('data-bs-theme', nuevoTema);
                const nuevoIcono = 'bi bi-brightness-high-fill';
                iconsito.className = nuevoIcono;
                localStorage.setItem('theme', nuevoTema);

            }

        });

    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

<style>
    .form-gor2 {
        border-width: 1px 1px 1px 20px; 
        border-radius: 50px;
        border-color: #2b2f69;
        border-style: solid; 
        width:950px;
        transition: all 0.3s ease;
    }

    [data-bs-theme="dark"] .form-gor2 {
        background-color: rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-color: rgba(255, 255, 255, 0.1);
        border-left-color: #41479b; 
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }
    
    
    [data-bs-theme="dark"] .form-gor2 input, 
    [data-bs-theme="dark"] .form-gor2 select {
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
    }

    [data-bs-theme="dark"] .form-gor2 input:focus, 
    [data-bs-theme="dark"] .form-gor2 select:focus {
        background-color: rgba(255, 255, 255, 0.15);
        border-color: rgba(255, 255, 255, 0.5);
        color: white;
        box-shadow: 0 0 0 0.25rem rgba(255, 255, 255, 0.1);
    }
</style>

</html>
