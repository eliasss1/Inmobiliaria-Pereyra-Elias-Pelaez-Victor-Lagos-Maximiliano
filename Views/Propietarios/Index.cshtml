@model IEnumerable<Inmobiliaria.Models.Propietario>

@{
    ViewData["Title"] = "Propietarios";
}

<div class="container mt-4">
    <h2>Listado de Propietarios</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary">Crear Nuevo Propietario</a>
    </p>

    <table class="table table-striped table-hover"></table>
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.IdPropietario)</th>
                <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                <th>@Html.DisplayNameFor(model => model.Apellido)</th>
                <th>@Html.DisplayNameFor(model => model.Dni)</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.IdPropietario)</td>
                    <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                    <td>@Html.DisplayFor(modelItem => item.Apellido)</td>
                    <td>@Html.DisplayFor(modelItem => item.Dni)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>
                        <!-- Enlace de acciones. -->
                        <a asp-action="Edit" asp-route-id="@item.IdPropietario" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.IdPropietario" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
</div>