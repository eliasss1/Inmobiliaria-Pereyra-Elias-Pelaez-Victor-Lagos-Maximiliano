@model Inmobiliaria.Models.Propietario

@{
    ViewData["Title"] = "Editar Propietario";
}

<div class="container d-flex justify-content-center align-items-center">
    <form asp-controller="Propietario" class="form-gor2 d-flex flex-column justify-content-start m-2 p-5 gap-2 shadow" asp-action="Edit" method="post">
        
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <h3 class="mb-0">Editar datos de @Model.Nombre @Model.Apellido</h3>
        <input type="hidden" asp-for="IdPropietario" />

        
        <div class="form-group w-50">
            <label asp-for="Nombre" class="form-label fw-bold"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="form-group w-50">
            <label asp-for="Apellido" class="form-label fw-bold"></label>
            <input asp-for="Apellido" class="form-control" />
            <span asp-validation-for="Apellido" class="text-danger"></span>
        </div>

    
        <div class="form-group w-50">
            <label asp-for="Dni" class="form-label fw-bold"></label>
            <input asp-for="Dni" class="form-control" />
            <span asp-validation-for="Dni" class="text-danger"></span>
        </div>
        <div class="form-group w-50">
            <label asp-for="Telefono" class="form-label fw-bold"></label>
            <input asp-for="Telefono" class="form-control" />
            <span asp-validation-for="Telefono" class="text-danger"></span>
        </div>
        <div class="form-group w-50">
            <label asp-for="Email" class="form-label fw-bold"></label>
            <input asp-for="Email" class="form-control" type="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end gap-1 mt-4">
            <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
            <button type="submit" class="btn btn-warning fw-bold">Guardar Cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 