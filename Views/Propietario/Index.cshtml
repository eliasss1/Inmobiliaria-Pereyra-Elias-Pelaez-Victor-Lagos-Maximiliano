@model IEnumerable<Inmobiliaria.Models.Propietario>

@{
    ViewData["Title"] = "Listado de Propietarios";
}

<div class="container mt-4">
    <h2 class="mb-4">Listado de Propietarios</h2>

    <form asp-action="Index" method="get" class="mb-3 d-flex">
        <input type="text" name="buscar" class="form-control me-2" placeholder="Buscar por nombre, apellido o DNI..." value="@ViewBag.Buscar" />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </form>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">Crear Nuevo Propietario</a>
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover align-middle border">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>DNI</th>
                    <th>Email</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.IdPropietario</td>
                        <td>@p.Nombre</td>
                        <td>@p.Apellido</td>
                        <td>@p.Dni</td>
                        <td>@p.Email</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@p.IdPropietario" class="btn btn-warning btn-sm">Editar</a>
                            <a asp-action="Eliminar" asp-route-id="@p.IdPropietario" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div>
            @if (ViewBag.Pagina > 1)
            {
                <a asp-action="Index" asp-route-pagina="@(ViewBag.Pagina - 1)" asp-route-buscar="@ViewBag.Buscar" class="btn btn-outline-primary btn-sm">Anterior</a>
            }
        </div>
        <span class="text-muted fw-bold">Página @ViewBag.Pagina de @ViewBag.TotalPaginas</span>
        <div>
            @if (ViewBag.Pagina < ViewBag.TotalPaginas)
            {
                <a asp-action="Index" asp-route-pagina="@(ViewBag.Pagina + 1)" asp-route-buscar="@ViewBag.Buscar" class="btn btn-outline-primary btn-sm">Siguiente</a>
            }
        </div>
    </div>
</div>