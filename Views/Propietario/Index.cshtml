    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover align-middle border">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>DNI</th>
                    <th>Email</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No se encontraron propietarios con esos criterios de busqueda.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.IdPropietario</td>
                            <td>@p.Nombre</td>
                            <td>@p.Apellido</td>
                            <td>@p.Dni</td>
                            <td>@p.Email</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@p.IdPropietario" class="btn btn-warning btn-sm">Editar</a>
                                <a asp-action="Eliminar" asp-route-id="@p.IdPropietario" class="btn btn-danger btn-sm" onclick="return confirm('¿Seguro que queres eliminar a este propietario?');">Eliminar</a>
                                <a asp-controller="Inmueble" asp-action="PorPropietario" asp-route-id="@p.IdPropietario" class="btn btn-info btn-sm">Ver Inmuebles</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    
    @if (Model != null && Model.Any())
    {
        <div class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination">
                    <li class="page-item @(ViewBag.Pagina == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.Pagina - 1)" asp-route-buscar="@ViewBag.Buscar">Anterior</a>
                    </li>
                    <li class="page-item active"><span class="page-link">Pagina @ViewBag.Pagina de @ViewBag.TotalPaginas</span></li>
                    <li class="page-item @(ViewBag.Pagina >= ViewBag.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.Pagina + 1)" asp-route-buscar="@ViewBag.Buscar">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>