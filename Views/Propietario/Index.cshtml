@model IEnumerable<Inmobiliaria.Models.Propietario>

@{
    ViewData["Title"] = "Listado de Propietarios";
}

<div class="container mt-4">
    <h2 class="mb-4">Listado de Propietarios</h2>

    <form asp-action="Index" method="get" class="mb-3 d-flex">
        <input type="text" name="buscar" class="form-control me-2" placeholder="Buscar por nombre, apellido o DNI..." value="@ViewBag.Buscar" />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </form>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">Crear Nuevo Propietario</a>
    </div>

