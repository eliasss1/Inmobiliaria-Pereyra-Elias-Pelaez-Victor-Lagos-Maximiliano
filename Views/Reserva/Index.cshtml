@model IEnumerable<Inmobiliaria.Models.Reserva>

<div class="container mt-4">
    <h2>Listado de Reservas</h2>
    <a asp-action="Create" class="btn btn-primary mb-3">Nueva Reserva</a>
    
    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Inquilino</th>
                <th>Inmueble</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Monto Diario</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.InquilinoAsociado.Nombre @item.InquilinoAsociado.Apellido</td>
                    <td>@item.InquilinoAsociado.Dni</td>
                    <td>@item.InmuebleAsociado.Direccion</td>
                    <td>@item.FechaInicio.ToShortDateString()</td>
                    <td>@item.FechaFin.ToShortDateString()</td>
                    <td>@item.MontoDiario</td>
                </tr>
            }
        </tbody>
    </table>
</div>