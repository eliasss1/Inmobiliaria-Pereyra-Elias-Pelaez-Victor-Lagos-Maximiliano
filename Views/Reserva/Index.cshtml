@model IEnumerable<Inmobiliaria.Models.Reserva>

<div class="container mt-4">
    <h2>Listado de Reservas</h2>
    <a asp-action="Create" class="btn btn-primary mb-3">Nueva Reserva</a>
    
    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Inquilino</th>
                <th>DNI</th>
                <th>ID INMUEBLE</th>
                <th>Direccion de inmueble</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Monto Diario</th>
                <th>Opciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.InquilinoAsociado.Nombre @item.InquilinoAsociado.Apellido</td>
                    <td>@item.InquilinoAsociado.Dni</td>
                    <td>@item.InmuebleAsociado.IdInmueble</td>
                    <td>@item.InmuebleAsociado.Direccion</td>
                    <td>@item.FechaDesde.ToShortDateString()</td>
                    <td>@item.FechaHasta.ToShortDateString()</td>
                    <td>@item.MontoPorDia</td>
                    <td class="d-flex gap-1">
                        <a asp-controller="Reserva" asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-controller="Reserva" asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-info btn-sm">Info</a>
                        <form asp-controller="Reserva" asp-action="Eliminar" asp-route-id="@item.IdReserva" method="post" onsubmit="return confirm('Seguro que deseas eliminar esta reserva?');">
                            <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>