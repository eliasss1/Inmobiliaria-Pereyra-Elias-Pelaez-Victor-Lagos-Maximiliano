@model IEnumerable<Inmobiliaria.Models.Reserva>

@{
    ViewData["Title"] = "Listado de Reservas";
}

<div class="container mt-4">

    <form asp-controller="Reserva" asp-action="Index" method="get" class="mb-3 d-flex">
        <input type="text" name="buscar" class="form-control me-2" placeholder="Buscar por Apellido de inquilino o Dirección..." value="@ViewBag.Buscar" />
        <button type="submit" class="btn btn-outline-secondary me-2">Buscar</button>
        <a asp-controller="Reserva" asp-action="Index" class="btn btn-outline-danger">Limpiar</a>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Listado de Reservas</h2>
        <a asp-controller="Reserva" asp-action="Create" class="btn btn-primary shadow-sm">
            Crear Nueva Reserva
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover align-middle border">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Inmueble</th>
                    <th>Inquilino</th>
                    <th>Desde</th>
                    <th>Hasta</th>
                    <th>Monto/Dia</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No se encontraron reservas con esos criterios de busqueda.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-bold">@r.IdReserva</td>
                            <td>@r.InmuebleAsociado?.Direccion</td>
                            <td>@r.InquilinoAsociado?.Nombre @r.InquilinoAsociado?.Apellido</td>
                            <td>@r.FechaDesde.ToShortDateString()</td>
                            <td>@r.FechaHasta.ToShortDateString()</td>
                            <td>$@r.MontoPorDia.ToString("N2")</td>
                            <td>
                                @if (r.Estado == 1)
                                {
                                    <span class="badge bg-success">Vigente</span>
                                }
                                else if (r.Estado == 2)
                                {
                                    <span class="badge bg-secondary">Finalizada</span>
                                }
                                else if (r.Estado == 3)
                                {
                                    <span class="badge bg-warning text-dark">Terminada Ant.</span>
                                }
                                else
                                {
                                    <span class="badge bg-dark">Desconocido</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@r.IdReserva" class="btn btn-warning btn-sm">Editar</a>
                                <form asp-action="Eliminar" asp-route-id="@r.IdReserva" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que queres eliminar esta reserva?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination">
                    <li class="page-item @(ViewBag.Pagina == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.Pagina - 1)" asp-route-buscar="@ViewBag.Buscar">Anterior</a>
                    </li>
                    <li class="page-item active"><span class="page-link">Página @ViewBag.Pagina de @ViewBag.TotalPaginas</span></li>
                    <li class="page-item @(ViewBag.Pagina >= ViewBag.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.Pagina + 1)" asp-route-buscar="@ViewBag.Buscar">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>