@model Inmobiliaria.Models.Reserva

<div class="container d-flex justify-content-center align-items-center">
    
    <form asp-controller="Reserva" asp-action="Create" method="post" class="form-gor2 d-flex flex-column justify-content-start m-2 p-5 gap-2 shadow">
        <h1 style=" font-family: 'Inter', sans-serif; font-weight: 500; letter-spacing: -0.02em;">Crear Reserva</h1>
        
        <div class="w-50  mb-3">
            <label>Inquilino</label>
            <select asp-for="IdInquilino" class="form-control" asp-items="ViewBag.Inquilinos">
                <option value="">-- Seleccione un Inquilino --</option>
            </select>
            <span asp-validation-for="IdInquilino" class="text-danger"></span>
        </div>
        
        <div class="w-50  mb-3">
            <label>Inmueble</label>
            <select asp-for="IdInmueble" class="form-control" asp-items="ViewBag.Inmuebles">
                <option value="">-- Seleccione un Inmueble --</option>
            </select>
            <span asp-validation-for="IdInmueble" class="text-danger"></span>
        </div>

        <div class="w-50  mb-3">
            <label>Fecha Inicio</label>
            <input asp-for="FechaDesde" type="date" class="form-control" />
            <span asp-validation-for="FechaDesde" class="text-danger"></span>
        </div>
        
        <div class="w-50 mb-3">
            <label>Fecha Fin</label>
            <input asp-for="FechaHasta" type="date" class="form-control" />
            <span asp-validation-for="FechaHasta" class="text-danger"></span>
        </div>
        
        <div class="w-50  mb-3">
            <label>Monto Por Dia</label>
            <input asp-for="MontoPorDia" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="MontoPorDia" class="text-danger"></span>
        </div>
            
        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            <button type="submit" class="btn btn-primary">Guardar Reserva</button>
        </div>
    </form>
</div>