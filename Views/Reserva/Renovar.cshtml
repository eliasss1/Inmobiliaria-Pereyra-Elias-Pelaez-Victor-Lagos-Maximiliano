@model Inmobiliaria.Models.Reserva
@{
    ViewData["Title"] = "Renovar Reserva";
    var original = ViewBag.ReservaOriginal as Inmobiliaria.Models.Reserva;
}
<div class="container d-flex justify-content-center align-items-center">
    <form asp-action="Renovar" method="post" class="form-gor2 d-flex flex-column justify-content-start m-2 p-5 gap-2 shadow">
        <h1>Renovar Reserva</h1>
        <p>Inmueble: @original?.InmuebleAsociado?.Direccion</p>
        <p>Inquilino: @original?.InquilinoAsociado?.Nombre @original?.InquilinoAsociado?.Apellido</p>
        
        <input type="hidden" asp-for="IdInmueble" />
        <input type="hidden" asp-for="IdInquilino" />
        <input type="hidden" asp-for="IdReserva" value="@original?.IdReserva" />

        <div class="mb-3">
            <label>Fecha Desde</label>
            <input asp-for="FechaDesde" type="date" class="form-control" />
            <span asp-validation-for="FechaDesde" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label>Fecha Hasta</label>
            <input asp-for="FechaHasta" type="date" class="form-control" />
            <span asp-validation-for="FechaHasta" class="text-danger"></span>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-success">Generar Nueva Reserva</button>
        </div>
    </form>
</div>
