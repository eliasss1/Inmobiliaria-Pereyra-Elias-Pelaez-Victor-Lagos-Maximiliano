@model Inmobiliaria.Models.Inquilino

@{
    ViewData["Title"] = "Nuevo Inquilino";
}

<div class="container d-flex justify-content-center align-items-center">
    
    <form class="form-gor2 d-flex flex-column justify-content-start m-2 p-5 gap-2 shadow" asp-action="Create"> 
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <h1 style="font-family: 'Inter', sans-serif; font-weight: 500; letter-spacing: -0.02em;">Nuevo Inquilino</h1>
        <div class="w-50 mb-3">
            <label asp-for="Nombre" class="form-label fw-bold">Nombre</label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. Juan" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class=" w-50  mb-3">
            <label asp-for="Apellido" class="form-label fw-bold">Apellido</label>
            <input asp-for="Apellido" class="form-control" placeholder="Ej. Pérez" />
            <span asp-validation-for="Apellido" class="text-danger"></span>
        </div>

        <div class=" w-50  mb-3">
            <label asp-for="Dni" class="form-label fw-bold">DNI</label>
            <input asp-for="Dni" class="form-control" placeholder="Ej. 12345678" />
            <span asp-validation-for="Dni" class="text-danger"></span>
        </div>

        <div class=" w-50  mb-3">
            <label asp-for="Telefono" class="form-label fw-bold">Teléfono</label>
            <input asp-for="Telefono" class="form-control" placeholder="Ej. 2664000000 (Opcional)" />
            <span asp-validation-for="Telefono" class="text-danger"></span>
        </div>

        <div class=" w-50  mb-3">
            <label asp-for="Email" class="form-label fw-bold">Correo Electrónico</label>
            <input asp-for="Email" class="form-control" placeholder="juan.perez@email.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Registrar</button>
        </div>
    </form>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
