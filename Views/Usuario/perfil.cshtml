@model Inmobiliaria.Models.Usuario

@{
    ViewData["Title"] = "Perfil";
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin-top: 10px;">
        <strong>¡Éxito!</strong> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-center">
    <div class="card p-1 align-items-center justify-content-center" style="min-width:800px; width:auto; height: 350px">
        <div id="infoNormal" class="d-flex justify-content-center align-items-center">
            <div class="burbuja-foto m-5 overflow-hidden d-flex justify-content-center align-items-center">
                <img src="@(string.IsNullOrEmpty(Model.Avatar) ? "/img/mr-musculo.png" : Model.Avatar)" class="w-100 h-100" style="object-fit: cover;" alt="Avatar" />
            </div>
            <div>
                <h3>@Model.Nombre @Model.Apellido</h3>
                <h6><strong>Email</strong></h6>
                <p>@Model.Email</p>
                <h6><strong>Rol</strong></h6>
                <p>@Model.Rol</p>
                <h6><strong>ID</strong></h6>
                <p>@Model.IdUsuario</p>
            </div>
            <div class="h-100 ps-4 me-4" style="padding-top: 32px">
                <button id="boton-editar" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-pencil">Editar</i>
                </button>
            </div>
            
        </div>
        <form id="infoParaEditar" method="post"  enctype="multipart/form-data" asp-controller="Usuario" asp-action="Perfil" class="d-flex justify-content-center align-items-center d-none">
            <label for="avatarFile" class="burbuja-foto m-5 overflow-hidden d-flex justify-content-center align-items-center" style="cursor: pointer; position: relative;">
                <img id="previewAvatar" src="@Model.Avatar"class="w-100 h-100" style="object-fit: cover;" alt="Avatar" />

                <div class="position-absolute w-100 h-100 d-flex justify-content-center align-items-center bg-dark bg-opacity-50 text-white" style="opacity: 0; transition: 0.3s;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0">
                    <i class="bi bi-camera fs-1"></i>
                </div>
            </label>
            
            
            <input type="file" name="AvatarFile" id="avatarFile" accept="image/*" class="d-none" onchange="previewImage(event)">
            <div>
                <div class="d-flex gap-1">
                    <h3 id="h3-nombre" contenteditable="true" style="outline: none;">@Model.Nombre</h3>
                    <input id="input-nombre" type="hidden" asp-for="Nombre"/>

                    <h3 id="h3-apellido" contenteditable="true" style="outline: none;">@Model.Apellido <i class="bi bi-pencil"></i></h3>
                    
                    <input id="input-apellido" type="hidden" asp-for="Apellido"/>

                </div>

                <input id="input-id" type="hidden" asp-for="IdUsuario"/>
                <input id="input-rol" type="hidden" asp-for="Rol"/>

                <h6><strong>Email</strong></h6>
                <p id="p-email" contenteditable="true" style="outline: none;">@Model.Email <i class="bi bi-pencil"></i></p>
                
                <input id="input-email" type="hidden" asp-for="Email"/>

                <a class="text-primary" asp-action="CambiarContraseña">Editar Contraseña</a>
            </div>
            <div class="h-100 ps-4 me-4" style="padding-top: 32px">
                <button id="boton-guardar" type="submit" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-save"> Guardar</i>
                </button>
                <a asp-controller="Usuario" asp-action="Perfil" id="boton-cancelar" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-x">Cancelar</i>
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    .burbuja-foto {
        width: 230px;
        height: 230px;
        border-radius: 50%;
        border: 1px solid #1520c0;
        transition: transform 0.3s ease-in-out;
    }

    .burbuja-foto:hover {
        transform: scale(1.1); 
    }

</style>


<script>

    const infoNormal = document.getElementById("infoNormal");
    const infoEditar = document.getElementById("infoParaEditar");
    const btnGuardar = document.getElementById("boton-guardar");
    const btnEditar = document.getElementById("boton-editar");

    const avatarInput = document.getElementById("avatarFile");

    const nombreEdit = document.getElementById("h3-nombre");
    const apellidoEdit = document.getElementById("h3-apellido");
    const emailEdit = document.getElementById("p-email");

    const nombreInput = document.getElementById("input-nombre");
    const apellidoInput = document.getElementById("input-apellido");
    const emailInput = document.getElementById("input-email");

    let nombreOriginal = "";
    let apellOriginal = "";
    let emailOriginal = "";
    let avatarChanged = false;

    function actualizarEstadoGuardar() {
        const cambios =
            nombreEdit.innerText.trim() !== nombreOriginal ||
            apellidoEdit.innerText.trim() !== apellOriginal ||
            emailEdit.innerText.trim() !== emailOriginal ||
            avatarChanged;

        btnGuardar.disabled = !cambios;
    }

    btnEditar.addEventListener("click", function () {
        infoNormal.classList.add("d-none");
        infoEditar.classList.remove("d-none");
        btnGuardar.disabled = true;
        avatarChanged = false;
    });

    document.addEventListener("DOMContentLoaded", function () {
        nombreOriginal = nombreEdit.innerText.trim();
        apellOriginal = apellidoEdit.innerText.trim();
        emailOriginal = emailEdit.innerText.trim();


        

        nombreEdit.addEventListener("blur", function () {
            nombreInput.value = nombreEdit.innerText.trim();
            actualizarEstadoGuardar();
        });
        nombreEdit.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                nombreEdit.blur();
            }
        });

        apellidoEdit.addEventListener("blur", function () {
            apellidoInput.value = apellidoEdit.innerText.trim();
            actualizarEstadoGuardar();
        });
        apellidoEdit.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                apellidoEdit.blur();
            }
        });

        emailEdit.addEventListener("blur", function () {
            emailInput.value = emailEdit.innerText.trim();
            actualizarEstadoGuardar();
        });
        emailEdit.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                emailEdit.blur();
            }
        });

        avatarInput.addEventListener("change", function (event) {
            previewImage(event);
            avatarChanged = true;
            actualizarEstadoGuardar();
        });
    });

    function previewImage(event) {
        const reader = new FileReader();
        reader.onload = function() {
            const preview = document.getElementById('previewAvatar');
            preview.src = reader.result;
        }
        if (event.target.files[0]) {
            reader.readAsDataURL(event.target.files[0]);
        }
    }

</script>