@model Inmobiliaria.Models.Usuario

@{
    ViewData["Title"] = "Perfil";
}
<div class="d-flex justify-content-center">
    <div class="card p-1 align-items-center justify-content-center" style="min-width:800px; width:auto; height: 350px">
        <div id="infoNormal" class="d-flex justify-content-center align-items-center">
            <div class="burbuja-foto m-5 ">
                    
            </div>
            <div>
                <h3>@Model.Nombre @Model.Apellido</h3>
                <h6><strong>Email</strong></h6>
                <p>@Model.Email</p>
                <h6><strong>Rol</strong></h6>
                <p>@Model.Rol</p>
                <h6><strong>ID</strong></h6>
                <p>@Model.IdUsuario</p>
            </div>
            <div class="h-100 ps-4 me-4" style="padding-top: 32px">
                <button id="boton-editar" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-pencil">Editar</i>
                </button>
            </div>
            
        </div>
        <form id="infoParaEditar" class="d-flex justify-content-center align-items-center d-none">
            <div class="burbuja-foto m-5 ">
                    
            </div>
            <div>
                <div class="d-flex gap-1">
                    <h3 id="h3-nombre" contenteditable="true">@Model.Nombre</h3>
                    <input id="input-nombre" type="hidden" name="Nombre" value="@Model.Nombre"/>

                    <h3 id="h3-apellido" contenteditable="true">@Model.Apellido</h3>
                    <input id="input-apellido" type="hidden" name="Nombre" value="@Model.Apellido"/>

                </div>

                <input id="input-id" type="hidden" name="Id" value="@Model.IdUsuario"/>

                <h6><strong>Email</strong></h6>
                <p id="p-email" contenteditable="true">@Model.Email</p>
                <input id="input-email" type="hidden" name="Email" value="@Model.Email"/>

                <a class="text-primary" data-bs-toggle="modal" data-bs-target="#modalContraseña">Editar Contraseña</a>
            </div>
            <div class="h-100 ps-4 me-4" style="padding-top: 32px">
                <a id="boton-guardar" type="submit" asp-controller="Usuario" asp-action="EditarPerfil" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-pencil">Guardar</i>
                </a>
            </div>
            
        </form>
    </div>

<style>
    .burbuja-foto {
        width: 230px;
        height: 230px;
        border-radius: 50%;
        border: 1px solid #1520c0;
        transition: transform 0.3s ease-in-out;
    }

    .burbuja-foto:hover {
        transform: scale(1.1); 
    }

</style>

<script>
    const infoNormal = document.getElementById("infoNormal");
    const infoEditar = document.getElementById("infoParaEditar");
    const btnGuardar = document.getElementById("boton-guardar");
    const btnEditar = document.getElementById("boton-editar");

    const nombreEdit = document.getElementById("h3-nombre");
    const apellidoEdit = document.getElementById("input-apellido");
    const emailEdit = document.getElementById("p-email");
    const contraEdit = document.getElementById("");

    const nombreInput = document.getElementById("input-nombre");
    const apellidoInput = document.getElementById("input-apellido");
    const emailInput = document.getElementById("input-email");
    const contraInput = document.getElementById("input-contraseña");

    btnEditar.addEventListener("click", function () {
            infoNormal.classList.add("d-none");
            infoEditar.classList.remove("d-none");
    });

    document.addEventListener("DOMContentLoaded", function () {
        
    });

    btnGuardar.addEventListener("click", function () {
        infoNormal.classList.remove("d-none");
        infoEditar.classList.add("d-none");
    });

</script>