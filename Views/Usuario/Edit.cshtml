@model Inmobiliaria.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container d-flex justify-content-center align-items-center">
    
    <form asp-action="Edit" method="post" class="form-gor2 d-flex flex-column justify-content-start m-2 p-5 gap-2 shadow">
        <input type="hidden" asp-for="IdUsuario" />

        <h1 style="font-family: 'Inter', sans-serif; font-weight: 500; letter-spacing: -0.02em;">Editar Usuario</h1>
        
        <div class="w-50">
            <label>Nombre</label>
            <input asp-for="Nombre" class="form-control" required />
        </div>
        
        <div class="w-50">
            <label>Apellido</label>
            <input asp-for="Apellido" class="form-control" required />
        </div>

        <div class="w-50">
            <label>Email</label>
            <input type="email" asp-for="Email" class="form-control" required />
        </div>

        <div class="w-50">
            <label>Rol</label>
            <select asp-for="Rol" class="form-select" required>
                <option value="Empleado">Empleado</option>
                <option value="Administrador">Administrador</option>
            </select>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-warning">Guardar Cambios</button>
        </div>
        
    </form>
</div>
