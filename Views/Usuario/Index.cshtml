@model IEnumerable<Inmobiliaria.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Gestión de Usuarios</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">Crear Nuevo Usuario</a>
    </div>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-success">@ViewBag.Mensaje</div>
    }

    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover align-middle border">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No hay usuarios registrados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.IdUsuario</td>
                            <td>@u.Nombre</td>
                            <td>@u.Apellido</td>
                            <td>@u.Email</td>
                            <td>
                                <span class="badge @(u.Rol == "Administrador" ? "bg-danger" : "bg-info")">@u.Rol</span>
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@u.IdUsuario" class="btn btn-warning btn-sm">Editar</a>
                                <a asp-action="Eliminar" asp-route-id="@u.IdUsuario" class="btn btn-danger btn-sm">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination">
                    <li class="page-item @(ViewBag.Pagina == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.Pagina - 1)">Anterior</a>
                    </li>
                    <li class="page-item active"><span class="page-link">Pagina @ViewBag.Pagina de @ViewBag.TotalPaginas</span></li>
                    <li class="page-item @(ViewBag.Pagina >= ViewBag.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.Pagina + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
