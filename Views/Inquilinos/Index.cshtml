@model IEnumerable<Inmobiliaria.Models.Inquilino>

@{
    ViewData["Title"] = "Listado de Inquilinos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Listado de Inquilinos</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            Crear Nuevo Inquilino
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Apellido y Nombre</th>
                            <th>DNI</th>
                            <th>Teléfono</th>
                            <th>Email</th>
                            <th class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No hay inquilinos registrados en el sistema.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@item.IdInquilino</td>
                                    <td>@item.Apellido, @item.Nombre</td>
                                    <td>@item.Dni</td>
                                    <td>
                                        @if (string.IsNullOrEmpty(item.Telefono))
                                        {
                                            <span class="text-muted">No registrado</span>
                                        }
                                        else
                                        {
                                            @item.Telefono
                                        }
                                    </td>
                                    <td>@item.Email</td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.IdInquilino" class="btn btn-warning text-white" title="Editar">
                                                Editar
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.IdInquilino" class="btn btn-info text-white" title="Ver Detalles">
                                                Detalles
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.IdInquilino" class="btn btn-danger" title="Eliminar">
                                                Eliminar
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>