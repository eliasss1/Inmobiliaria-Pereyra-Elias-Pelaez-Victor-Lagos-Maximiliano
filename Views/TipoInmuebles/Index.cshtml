@model IEnumerable<Inmobiliaria.Models.TipoInmueble>
@{ ViewData["Title"] = "Tipos de Inmueble"; }

<div class="container mt-4">
    <h2>Tipos de Inmueble</h2>
    <p><a asp-action="Create" class="btn btn-primary">Nuevo Tipo</a></p>
    
    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@item.IdTipoInmueble</td>
                    <td>@item.Nombre</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.IdTipoInmueble" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.IdTipoInmueble" class="btn btn-sm btn-info">Detalles</a>
                        <a asp-action="Eliminar" asp-route-id="@item.IdTipoInmueble" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex justify-content-between mt-3">
        @if (ViewBag.Pagina > 1) {
            <a asp-action="Index" asp-route-pagina="@(ViewBag.Pagina - 1)" class="btn btn-outline-primary btn-sm">Anterior</a>
        } else { <div></div> }
        <span>Pagina @ViewBag.Pagina de @ViewBag.TotalPaginas</span>
        @if (ViewBag.Pagina < ViewBag.TotalPaginas) {
            <a asp-action="Index" asp-route-pagina="@(ViewBag.Pagina + 1)" class="btn btn-outline-primary btn-sm">Siguiente</a>
        } else { <div></div> }
    </div>
</div>