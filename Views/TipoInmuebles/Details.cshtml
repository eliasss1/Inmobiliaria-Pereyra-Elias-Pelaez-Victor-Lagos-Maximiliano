@model Inmobiliaria.Models.TipoInmueble
@{ ViewData["Title"] = "Detalles del Tipo"; }

<div class="container mt-4">
    <h2>Detalles del Registro</h2>
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">ID del Tipo</dt>
            <dd class="col-sm-10">@Model.IdTipoInmueble</dd>
            <dt class="col-sm-2">Descripcion</dt>
            <dd class="col-sm-10">@Model.Nombre</dd>
        </dl>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.IdTipoInmueble" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Volver a la Lista</a>
    </div>
</div>