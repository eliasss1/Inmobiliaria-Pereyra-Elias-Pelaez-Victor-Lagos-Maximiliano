@model Inmobiliaria.Models.TipoInmueble
@{ ViewData["Title"] = "Eliminar Tipo"; }

<div class="container mt-4">
    <h3 class="text-danger">¿Estas seguro de eliminar este tipo de inmueble?</h3>
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">ID</dt>
            <dd class="col-sm-10">@Model.IdTipoInmueble</dd>
            <dt class="col-sm-2">Nombre</dt>
            <dd class="col-sm-10">@Model.Nombre</dd>
        </dl>
        <form asp-action="Eliminar" method="post">
            <input type="hidden" asp-for="IdTipoInmueble" />
            <input type="submit" value="Eliminar de la Base de Datos" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
        </form>
    </div>
</div>